     return len(s) >= 2 and s[0].isalpha() and s[1] == ":"
 
 
+# session_key never flows into a filesystem path (only session_id does; see
+# hermes_state ``sessions_dir / f"{session_id}.json"``), but it does embed
+# platform-native chat ids. DingTalk conversation ids are base64 whose
+# alphabet includes ``/``, so the blanket ``/`` rejection above produces
+# false positives that silently drop those sessions on every reload. Keep
+# rejecting genuinely path-shaped values (parent traversal, backslashes,
+# absolute/home prefixes, drive letters) while allowing interior ``/``:
+# base64 cannot produce ``..``, so no traversal payload is admitted.
+def _is_session_key_unsafe(value: object) -> bool:
+    """Return True if a session key looks like a path-escape attempt."""
+    if not value:
+        return False
+    s = str(value)
+    if ".." in s or "\\" in s:
+        return True
+    if s.startswith(("/", "~")):
+        return True
+    return len(s) >= 2 and s[0].isalpha() and s[1] == ":" and s[2:3] in ("/", "\\")
+
+
 @dataclass
 class SessionSource:
     """
