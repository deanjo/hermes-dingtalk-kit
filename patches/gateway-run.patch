+def _should_prompt_for_home_channel(source: Any) -> bool:
+    platform = getattr(source, "platform", None)
+    if not platform or platform in {Platform.LOCAL, Platform.WEBHOOK}:
+        return False
+    if platform == Platform.DINGTALK and getattr(source, "chat_type", "") == "group":
+        return False
+    return True
